---
permalink: /
---
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
<meta name="description" content="{{ site.description }}" />
<meta name="author" content="{{ site.author }}" />
<meta name="theme-color" content="#DFE3E6" media="(prefers-color-scheme: light)" />
<meta name="theme-color" content="#121312" media="(prefers-color-scheme: dark)" />
<link rel="canonical" href="{{ site.url }}" />

<title>{{ site.title }}</title>

<!-- Open Graph -->
<meta property="og:title" content="{{ site.title }}">
<meta property="og:description" content="{{ site.og.description }}">
<meta property="og:url" content="{{ site.url }}">
<meta property="og:type" content="website">
<meta property="og:site_name" content="{{ site.name }}">
<meta property="og:locale" content="en_US">
<meta property="og:image" content="{{ site.url }}/{{ site.og.image }}">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:alt" content="{{ site.og.imageAlt }}">

<!-- Twitter Card -->
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ site.title }}">
<meta name="twitter:description" content="{{ site.og.description }}">
<meta name="twitter:image" content="{{ site.url }}/{{ site.og.image }}">
<meta name="twitter:image:alt" content="{{ site.og.imageAlt }}">

<!-- Structured data -->
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Person",
  "name": {{ site.profile.heading | dump | safe }},
  "url": {{ site.url | dump | safe }},
  "jobTitle": {{ site.jobTitle | dump | safe }},
  "sameAs": [
{% for key in site.socials %}
    {{ site.links[key] | dump | safe }},
{% endfor %}
    {{ site.links.portfolio | dump | safe }}
  ]
}
</script>

<!-- favicons -->
<link rel="icon" type="image/svg+xml" href="assets/meta/favicons/favicon.svg" />
<link rel="icon" type="image/png" sizes="32x32" href="assets/meta/favicons/favicon-32x32.png" />
<link rel="icon" type="image/png" sizes="16x16" href="assets/meta/favicons/favicon-16x16.png" />
<link rel="apple-touch-icon" sizes="180x180" href="assets/meta/favicons/apple-touch-icon.png" />
<link rel="manifest" href="assets/meta/favicons/site.webmanifest" />

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@500;600&family=Manrope:wght@500;600;700;800&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/remixicon@latest/fonts/remixicon.css" />
<link rel="stylesheet" href="style.css" />
</head>
<body>

  <header class="navbar">
    <div class="navbar-inner">
      <a href="{{ site.links.portfolio }}" class="logo" aria-label="{{ site.name }} portfolio">BASSAM<span class="logo-dot">.</span>SYS</a>
      <span class="sys-status" aria-hidden="true">SYS/OK</span>
      <button id="theme-toggle" class="theme-toggle" aria-label="Switch to dark mode" aria-pressed="false">
        <i class="ri-sun-fill icon icon-sun" aria-hidden="true"></i>
        <i class="ri-moon-fill icon icon-moon" aria-hidden="true"></i>
      </button>
    </div>
  </header>

  <div class="page">
    <main class="card">
      <img class="avatar" src="{{ site.media.avatar }}" alt="{{ site.profile.avatarAlt }}" width="112" height="112" />
      <h1 class="name">{{ site.profile.heading }}</h1>
      <p class="bio">{{ site.profile.bio }}</p>

      <nav class="routes" aria-label="Main links">
        {% for route in site.routes -%}
        {%- set href -%}
          {%- if route.link == "email" -%}mailto:{{ site.links.email }}
          {%- elif route.link == "cv" -%}{{ site.media.cv }}
          {%- else -%}{{ site.links[route.link] }}
          {%- endif -%}
        {%- endset -%}
        <a class="route{% if route.active %} route-active{% endif %}" href="{{ href }}"{% if href.indexOf("http") == 0 %} target="_blank" rel="noopener"{% endif %}>
          <span class="route-main">
            <span class="route-method">{{ route.method }}</span>
            <span class="route-path">{{ route.path }}</span>
            <span class="route-label">{{ route.label }}</span>
          </span>
          <span class="route-meta">
            <span class="route-status">{{ route.status }}</span>
            <span class="route-arrow" aria-hidden="true"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 6l6 6-6 6"/></svg></span>
          </span>
        </a>
        {% endfor -%}
      </nav>

      {% set socialMeta = {
        "github": {"class": "ri-github-fill", "label": "GitHub"},
        "linkedin": {"class": "ri-linkedin-box-fill", "label": "LinkedIn"},
        "facebook": {"class": "ri-facebook-circle-fill", "label": "Facebook"},
        "instagram": {"class": "ri-instagram-fill", "label": "Instagram"}
      } %}
      <nav class="socials" aria-label="Social profiles">
        {% for key in site.socials -%}
        <a class="social-link" href="{{ site.links[key] }}" target="_blank" rel="noopener" aria-label="{{ socialMeta[key].label }}">
          <i class="{{ socialMeta[key].class }}" aria-hidden="true"></i>
        </a>
        {% endfor -%}
      </nav>
    </main>
  </div>

  <script src="script.js"></script>
</body>
</html>
